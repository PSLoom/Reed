<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RequiresKernelModule>true</RequiresKernelModule>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Restore the published kernel too, so a standalone benchmark build supports Measure-Startup.ps1. -->
    <PackageReference Include="PSLoom" GeneratePathProperty="true" />
    <ProjectReference Include="..\..\src\PSLoom.Reed\PSLoom.Reed.csproj" />
  </ItemGroup>
</Project>
